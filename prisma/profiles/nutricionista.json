{
  "key": "nutricionista",
  "name": "Nutricionista",
  "config": {
    "category": "Saúde",
    "description": "Consultas de nutrição clínica e esportiva, presencial e online.",
    "terminology": {
      "client": {
        "singular": "paciente",
        "plural": "pacientes"
      },
      "appointment": {
        "singular": "consulta",
        "plural": "consultas"
      },
      "record": "Prontuário nutricional",
      "professional": "Nutricionista"
    },
    "registry": {
      "label": "CRN",
      "required": true
    },
    "professionalFields": [],
    "clientFields": [
      {
        "key": "birthDate",
        "label": "Data de nascimento",
        "type": "date",
        "required": true
      }
    ],
    "intakeForm": {
      "name": "Pré-consulta",
      "sections": [
        {
          "title": "Hábitos",
          "fields": [
            {
              "key": "goal",
              "label": "Objetivo",
              "type": "select",
              "options": [
                "Emagrecimento",
                "Ganho de massa",
                "Saúde",
                "Performance",
                "Outro"
              ],
              "required": true
            },
            {
              "key": "restrictions",
              "label": "Restrições ou alergias alimentares",
              "type": "text"
            }
          ]
        }
      ]
    },
    "services": [
      {
        "name": "Primeira consulta",
        "durationMin": 60,
        "priceCents": 25000,
        "modality": "IN_PERSON"
      },
      {
        "name": "Retorno",
        "durationMin": 40,
        "priceCents": 15000,
        "modality": "IN_PERSON",
        "returnDays": 30
      },
      {
        "name": "Consulta online",
        "durationMin": 50,
        "priceCents": 20000,
        "modality": "ONLINE"
      },
      {
        "name": "Nutrição esportiva",
        "durationMin": 60,
        "priceCents": 28000,
        "modality": "IN_PERSON"
      },
      {
        "name": "Nutrição materno-infantil",
        "durationMin": 60,
        "priceCents": 26000,
        "modality": "IN_PERSON"
      }
    ],
    "recordTemplate": {
      "name": "Consulta",
      "sections": [
        {
          "title": "Avaliação",
          "fields": [
            {
              "key": "weight",
              "label": "Peso (kg)",
              "type": "number"
            },
            {
              "key": "height",
              "label": "Altura (cm)",
              "type": "number"
            },
            {
              "key": "assessment",
              "label": "Avaliação",
              "type": "textarea",
              "required": true
            },
            {
              "key": "plan",
              "label": "Plano alimentar / orientações",
              "type": "textarea"
            }
          ]
        }
      ]
    },
    "documents": [
      {
        "key": "plano-alimentar",
        "name": "Plano alimentar",
        "direction": "OUT"
      },
      {
        "key": "lista-compras",
        "name": "Lista de compras",
        "direction": "OUT"
      },
      {
        "key": "exames",
        "name": "Exames laboratoriais",
        "direction": "IN"
      }
    ],
    "compliance": {
      "validation": "PENDENTE_VALIDACAO",
      "confidentiality": "SIGILOSO",
      "retentionYears": 5,
      "signatureRequired": true,
      "consents": [
        "Tratamento de dados pessoais sensíveis de saúde (LGPD)"
      ],
      "recordHiddenFrom": [
        "RECEPTION",
        "FINANCE"
      ],
      "notes": "Prazos e regras a validar por especialista conforme normas do conselho de Nutrição."
    },
    "cancellationPolicy": {
      "minHoursBefore": 24
    },
    "rules": [
      {
        "key": "faltas-aviso",
        "name": "Avisar após 2 faltas seguidas",
        "trigger": "NO_SHOW",
        "conditions": {
          "consecutiveGte": 2
        },
        "actions": [
          {
            "type": "NOTIFY_CLIENT",
            "message": "Notamos que você faltou a {{count}} consultas seguidas. Quer reagendar?"
          }
        ],
        "mode": "AUTO"
      }
    ],
    "careTypes": [
      {
        "key": "emagrecimento",
        "name": "Emagrecimento e reeducação alimentar",
        "description": "Para perder peso com saúde e mudar hábitos de forma sustentável.",
        "services": [
          "Primeira consulta",
          "Consulta online"
        ],
        "triage": {
          "questions": [
            {
              "key": "meta",
              "label": "Quanto gostaria de perder?",
              "type": "select",
              "options": [
                "Até 5 kg",
                "5 a 15 kg",
                "Mais de 15 kg",
                "Não sei"
              ],
              "required": true
            },
            {
              "key": "condicoes",
              "label": "Você tem alguma destas condições?",
              "type": "multiselect",
              "options": [
                "Diabetes",
                "Pressão alta",
                "Colesterol alto",
                "Tireoide",
                "Gastrite ou refluxo",
                "Nenhuma"
              ],
              "required": false
            },
            {
              "key": "comportamento",
              "label": "Já teve episódios de compulsão, vômito provocado ou restrição extrema?",
              "type": "select",
              "options": [
                "Não",
                "Sim",
                "Prefiro não responder"
              ],
              "required": true
            },
            {
              "key": "exames",
              "label": "Tem exames de sangue recentes?",
              "type": "select",
              "options": [
                "Sim",
                "Não"
              ],
              "required": false
            },
            {
              "key": "modalidade",
              "label": "Como prefere ser atendido(a)?",
              "type": "select",
              "options": [
                "Presencial",
                "Online",
                "Tanto faz"
              ],
              "required": true
            }
          ],
          "rules": [
            {
              "if": {
                "field": "modalidade",
                "equals": "Online"
              },
              "then": {
                "service": "Consulta online",
                "modality": "ONLINE"
              }
            },
            {
              "if": {
                "field": "comportamento",
                "equals": "Sim"
              },
              "then": {
                "priority": "ALTA",
                "tags": [
                  "cuidado-comportamento-alimentar"
                ],
                "recommend": "Acompanhamento conjunto com psicólogo pode ser indicado."
              }
            },
            {
              "if": {
                "field": "exames",
                "equals": "Não"
              },
              "then": {
                "recommend": "Peça exames de rotina ao seu médico ou traga os mais recentes."
              }
            },
            {
              "if": {
                "field": "condicoes",
                "in": [
                  "Diabetes",
                  "Pressão alta",
                  "Colesterol alto",
                  "Tireoide",
                  "Gastrite ou refluxo"
                ]
              },
              "then": {
                "tags": [
                  "condição-clínica"
                ]
              }
            }
          ]
        }
      },
      {
        "key": "esportiva",
        "name": "Nutrição esportiva",
        "description": "Ganho de massa, performance e preparação para provas.",
        "services": [
          "Nutrição esportiva"
        ],
        "triage": {
          "questions": [
            {
              "key": "esporte",
              "label": "Qual esporte ou atividade você pratica?",
              "type": "text",
              "required": true
            },
            {
              "key": "objetivo",
              "label": "Seu objetivo",
              "type": "select",
              "options": [
                "Ganho de massa",
                "Performance ou prova",
                "Perda de gordura"
              ],
              "required": true
            },
            {
              "key": "treinos",
              "label": "Quantos treinos por semana?",
              "type": "select",
              "options": [
                "1 a 2",
                "3 a 4",
                "5 ou mais"
              ],
              "required": false
            },
            {
              "key": "prova",
              "label": "Tem prova ou competição marcada?",
              "type": "select",
              "options": [
                "Não",
                "Sim"
              ],
              "required": false
            },
            {
              "key": "data_prova",
              "label": "Data da prova",
              "type": "date",
              "required": false,
              "showIf": {
                "field": "prova",
                "equals": "Sim"
              }
            },
            {
              "key": "suplementos",
              "label": "Usa suplementos? Quais?",
              "type": "textarea",
              "required": false
            }
          ],
          "rules": [
            {
              "if": {
                "field": "prova",
                "equals": "Sim"
              },
              "then": {
                "priority": "ALTA",
                "recommend": "Planejar a estratégia nutricional até a data da prova."
              }
            }
          ]
        }
      },
      {
        "key": "clinica",
        "name": "Condição de saúde",
        "description": "Diabetes, doença renal, intestino, alergias e pós-bariátrica.",
        "services": [
          "Primeira consulta",
          "Consulta online"
        ],
        "triage": {
          "questions": [
            {
              "key": "condicao",
              "label": "Qual condição?",
              "type": "multiselect",
              "options": [
                "Diabetes",
                "Doença renal",
                "Doenças intestinais",
                "Alergia ou intolerância alimentar",
                "Pós-cirurgia bariátrica",
                "Outra"
              ],
              "required": true
            },
            {
              "key": "pedido",
              "label": "Tem encaminhamento médico?",
              "type": "select",
              "options": [
                "Não",
                "Sim"
              ],
              "required": false
            },
            {
              "key": "modalidade",
              "label": "Como prefere ser atendido(a)?",
              "type": "select",
              "options": [
                "Presencial",
                "Online",
                "Tanto faz"
              ],
              "required": true
            }
          ],
          "rules": [
            {
              "if": {
                "field": "condicao",
                "in": [
                  "Doença renal",
                  "Pós-cirurgia bariátrica",
                  "Diabetes"
                ]
              },
              "then": {
                "tags": [
                  "condição-clínica"
                ],
                "recommend": "Trazer exames e relatório médico; o plano será ajustado ao tratamento."
              }
            },
            {
              "if": {
                "field": "modalidade",
                "equals": "Online"
              },
              "then": {
                "service": "Consulta online",
                "modality": "ONLINE"
              }
            }
          ]
        }
      },
      {
        "key": "materno-infantil",
        "name": "Gestação, amamentação e infância",
        "description": "Alimentação na gestação e amamentação, introdução alimentar e crianças.",
        "services": [
          "Nutrição materno-infantil"
        ],
        "triage": {
          "questions": [
            {
              "key": "fase",
              "label": "Qual a fase?",
              "type": "select",
              "options": [
                "Gestante",
                "Amamentando",
                "Introdução alimentar do bebê",
                "Criança até 12 anos"
              ],
              "required": true
            },
            {
              "key": "semanas",
              "label": "Quantas semanas de gestação?",
              "type": "number",
              "required": false,
              "showIf": {
                "field": "fase",
                "equals": "Gestante"
              }
            },
            {
              "key": "condicoes",
              "label": "Alguma destas condições?",
              "type": "multiselect",
              "options": [
                "Diabetes gestacional",
                "Pressão alta",
                "Anemia",
                "Nenhuma"
              ],
              "required": false
            }
          ],
          "rules": [
            {
              "if": {
                "field": "fase",
                "equals": "Gestante"
              },
              "then": {
                "tags": [
                  "gestante"
                ]
              }
            },
            {
              "if": {
                "field": "condicoes",
                "equals": "Diabetes gestacional"
              },
              "then": {
                "priority": "ALTA",
                "recommend": "Diabetes gestacional: alinhar o plano com o pré-natal."
              }
            },
            {
              "if": {
                "field": "fase",
                "in": [
                  "Introdução alimentar do bebê",
                  "Criança até 12 anos"
                ]
              },
              "then": {
                "tags": [
                  "menor-de-idade"
                ],
                "recommend": "Comparecer com o responsável."
              }
            }
          ]
        }
      }
    ]
  }
}
