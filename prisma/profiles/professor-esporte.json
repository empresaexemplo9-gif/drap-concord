{
  "key": "professor-esporte",
  "name": "Professor(a) de esporte",
  "config": {
    "category": "Esporte e bem-estar",
    "description": "Aulas de tênis, natação, artes marciais e outras modalidades, individuais ou em turma.",
    "terminology": {
      "client": {
        "singular": "aluno",
        "plural": "alunos"
      },
      "appointment": {
        "singular": "aula",
        "plural": "aulas"
      },
      "record": "Registro da aula",
      "professional": "Professor(a)"
    },
    "registry": {
      "label": "CREF",
      "required": false
    },
    "professionalFields": [
      {
        "key": "sport",
        "label": "Modalidade",
        "type": "text",
        "required": true
      }
    ],
    "clientFields": [
      {
        "key": "birthDate",
        "label": "Data de nascimento",
        "type": "date"
      },
      {
        "key": "level",
        "label": "Nível",
        "type": "select",
        "options": [
          "Iniciante",
          "Intermediário",
          "Avançado"
        ]
      }
    ],
    "services": [
      {
        "name": "Aula experimental",
        "durationMin": 60,
        "priceCents": 0,
        "modality": "IN_PERSON"
      },
      {
        "name": "Aula individual",
        "durationMin": 60,
        "priceCents": 15000,
        "modality": "IN_PERSON",
        "recurrence": "semanal"
      },
      {
        "name": "Aula em dupla",
        "durationMin": 60,
        "priceCents": 10000,
        "modality": "IN_PERSON"
      },
      {
        "name": "Aula em turma",
        "durationMin": 60,
        "priceCents": 6000,
        "modality": "IN_PERSON"
      },
      {
        "name": "Treino para competição",
        "durationMin": 90,
        "priceCents": 22000,
        "modality": "IN_PERSON"
      }
    ],
    "recordTemplate": {
      "name": "Aula",
      "sections": [
        {
          "title": "Conteúdo",
          "fields": [
            {
              "key": "content",
              "label": "Fundamentos trabalhados",
              "type": "textarea",
              "required": true
            },
            {
              "key": "progress",
              "label": "Evolução do aluno",
              "type": "scale",
              "min": 1,
              "max": 5
            }
          ]
        }
      ]
    },
    "documents": [
      {
        "key": "plano-aula",
        "name": "Plano de aulas",
        "direction": "OUT"
      },
      {
        "key": "atestado",
        "name": "Atestado médico",
        "direction": "IN"
      }
    ],
    "compliance": {
      "validation": "PENDENTE_VALIDACAO",
      "confidentiality": "NORMAL",
      "retentionYears": 1,
      "signatureRequired": false,
      "consents": [
        "Tratamento de dados pessoais (LGPD)",
        "Uso de imagem (opcional)"
      ],
      "recordHiddenFrom": [],
      "notes": "Exigências a validar por especialista."
    },
    "cancellationPolicy": {
      "minHoursBefore": 6
    },
    "rules": [
      {
        "key": "faltas-aviso",
        "name": "Avisar após 2 faltas seguidas",
        "trigger": "NO_SHOW",
        "conditions": {
          "consecutiveGte": 2
        },
        "actions": [
          {
            "type": "NOTIFY_CLIENT",
            "message": "Notamos que você faltou a {{count}} aulas seguidas. Quer reagendar?"
          }
        ],
        "mode": "AUTO"
      }
    ],
    "careTypes": [
      {
        "key": "iniciacao",
        "name": "Iniciação (começar do zero)",
        "description": "Para quem nunca praticou ou está voltando depois de muito tempo.",
        "services": [
          "Aula experimental",
          "Aula em turma",
          "Aula individual"
        ],
        "triage": {
          "questions": [
            {
              "key": "para_quem",
              "label": "Para quem é?",
              "type": "select",
              "options": [
                "Para mim",
                "Para meu filho ou filha"
              ],
              "required": true
            },
            {
              "key": "idade",
              "label": "Faixa de idade",
              "type": "select",
              "options": [
                "4 a 7 anos",
                "8 a 12 anos",
                "13 a 17 anos",
                "18 a 39 anos",
                "40 a 59 anos",
                "60 anos ou mais"
              ],
              "required": true
            },
            {
              "key": "formato",
              "label": "Prefere aula:",
              "type": "select",
              "options": [
                "Individual",
                "Em turma",
                "Tanto faz"
              ],
              "required": true
            },
            {
              "key": "saude",
              "label": "Tem alguma condição de saúde ou lesão?",
              "type": "select",
              "options": [
                "Não",
                "Sim"
              ],
              "required": false
            }
          ],
          "rules": [
            {
              "if": {
                "field": "idade",
                "in": [
                  "4 a 7 anos",
                  "8 a 12 anos",
                  "13 a 17 anos"
                ]
              },
              "then": {
                "tags": [
                  "menor-de-idade"
                ]
              }
            },
            {
              "if": {
                "field": "formato",
                "equals": "Individual"
              },
              "then": {
                "recommend": "Depois da aula experimental, seguir em aulas individuais."
              }
            },
            {
              "if": {
                "field": "formato",
                "equals": "Em turma"
              },
              "then": {
                "recommend": "Depois da aula experimental, indicar uma turma do mesmo nível."
              }
            },
            {
              "if": {
                "field": "saude",
                "equals": "Sim"
              },
              "then": {
                "tags": [
                  "exige-atestado"
                ],
                "recommend": "Trazer atestado médico."
              }
            }
          ]
        }
      },
      {
        "key": "aperfeicoamento",
        "name": "Aperfeiçoamento técnico",
        "description": "Para quem já pratica e quer evoluir técnica e tática.",
        "services": [
          "Aula individual",
          "Aula em dupla",
          "Aula em turma"
        ],
        "triage": {
          "questions": [
            {
              "key": "nivel",
              "label": "Seu nível",
              "type": "select",
              "options": [
                "Iniciante",
                "Intermediário",
                "Avançado"
              ],
              "required": true
            },
            {
              "key": "foco",
              "label": "O que quer melhorar?",
              "type": "multiselect",
              "options": [
                "Técnica",
                "Tática ou leitura de jogo",
                "Condicionamento",
                "Mental"
              ],
              "required": false
            },
            {
              "key": "formato",
              "label": "Formato",
              "type": "select",
              "options": [
                "Individual",
                "Em dupla",
                "Em turma"
              ],
              "required": true
            }
          ],
          "rules": [
            {
              "if": {
                "field": "formato",
                "equals": "Em dupla"
              },
              "then": {
                "service": "Aula em dupla"
              }
            },
            {
              "if": {
                "field": "formato",
                "equals": "Em turma"
              },
              "then": {
                "service": "Aula em turma"
              }
            }
          ]
        }
      },
      {
        "key": "competicao",
        "name": "Preparação para competição",
        "description": "Treino focado em torneios e campeonatos.",
        "services": [
          "Treino para competição"
        ],
        "triage": {
          "questions": [
            {
              "key": "tem_data",
              "label": "Já tem competição marcada?",
              "type": "select",
              "options": [
                "Não",
                "Sim"
              ],
              "required": true
            },
            {
              "key": "data",
              "label": "Data da competição",
              "type": "date",
              "required": false,
              "showIf": {
                "field": "tem_data",
                "equals": "Sim"
              }
            },
            {
              "key": "nivel",
              "label": "Nível da competição",
              "type": "select",
              "options": [
                "Amador ou clube",
                "Estadual",
                "Nacional ou internacional"
              ],
              "required": false
            },
            {
              "key": "lesoes",
              "label": "Tem lesões ou dores?",
              "type": "textarea",
              "required": false
            }
          ],
          "rules": [
            {
              "if": {
                "field": "tem_data",
                "equals": "Sim"
              },
              "then": {
                "priority": "ALTA",
                "recommend": "Montar plano de treino até a data da competição."
              }
            }
          ]
        }
      }
    ]
  }
}
