{
  "key": "personalizado",
  "name": "Outros / Personalizado",
  "config": {
    "category": "Outros serviços",
    "description": "Monte tudo do seu jeito: termos, serviços, ficha e regras.",
    "terminology": {
      "client": {
        "singular": "cliente",
        "plural": "clientes"
      },
      "appointment": {
        "singular": "atendimento",
        "plural": "atendimentos"
      },
      "record": "Registro do atendimento",
      "professional": "Profissional"
    },
    "professionalFields": [],
    "clientFields": [],
    "services": [
      {
        "name": "Atendimento",
        "durationMin": 60,
        "priceCents": 0,
        "modality": "IN_PERSON"
      }
    ],
    "recordTemplate": {
      "name": "Atendimento",
      "sections": [
        {
          "title": "Registro",
          "fields": [
            {
              "key": "notes",
              "label": "Anotações",
              "type": "textarea",
              "required": true
            }
          ]
        }
      ]
    },
    "documents": [
      {
        "key": "documento",
        "name": "Documento",
        "direction": "BOTH"
      }
    ],
    "compliance": {
      "validation": "PENDENTE_VALIDACAO",
      "confidentiality": "NORMAL",
      "retentionYears": 1,
      "signatureRequired": false,
      "consents": [
        "Tratamento de dados pessoais (LGPD)"
      ],
      "recordHiddenFrom": [],
      "notes": "Defina as regras da sua área com um especialista."
    },
    "cancellationPolicy": {
      "minHoursBefore": 12
    },
    "rules": [],
    "careTypes": [
      {
        "key": "geral",
        "name": "Atendimento",
        "description": "Conte o que você precisa e o profissional prepara o atendimento.",
        "services": [
          "Atendimento"
        ],
        "triage": {
          "questions": [
            {
              "key": "necessidade",
              "label": "O que você precisa?",
              "type": "textarea",
              "required": true
            },
            {
              "key": "urgencia",
              "label": "Para quando?",
              "type": "select",
              "options": [
                "Sem pressa",
                "Nesta semana",
                "Hoje ou o quanto antes"
              ],
              "required": true
            },
            {
              "key": "modalidade",
              "label": "Como prefere?",
              "type": "select",
              "options": [
                "Presencial",
                "Online",
                "Em domicílio"
              ],
              "required": true
            },
            {
              "key": "primeira",
              "label": "É a primeira vez com este profissional?",
              "type": "select",
              "options": [
                "Sim",
                "Não"
              ],
              "required": false
            }
          ],
          "rules": [
            {
              "if": {
                "field": "urgencia",
                "equals": "Hoje ou o quanto antes"
              },
              "then": {
                "priority": "ALTA"
              }
            },
            {
              "if": {
                "field": "modalidade",
                "equals": "Online"
              },
              "then": {
                "modality": "ONLINE"
              }
            },
            {
              "if": {
                "field": "modalidade",
                "equals": "Em domicílio"
              },
              "then": {
                "modality": "HOME"
              }
            }
          ]
        }
      }
    ]
  }
}
