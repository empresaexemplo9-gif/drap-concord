{
  "key": "professor-particular",
  "name": "Professor(a) particular",
  "config": {
    "category": "Educação",
    "description": "Aulas particulares, reforço escolar, idiomas e preparação para provas.",
    "terminology": {
      "client": {
        "singular": "aluno",
        "plural": "alunos"
      },
      "appointment": {
        "singular": "aula",
        "plural": "aulas"
      },
      "record": "Diário de aula",
      "professional": "Professor(a)"
    },
    "professionalFields": [
      {
        "key": "subjects",
        "label": "Disciplinas",
        "type": "text",
        "required": true
      }
    ],
    "clientFields": [
      {
        "key": "school",
        "label": "Escola / série",
        "type": "text"
      },
      {
        "key": "guardian",
        "label": "Nome do responsável (se menor de idade)",
        "type": "text"
      }
    ],
    "services": [
      {
        "name": "Aula particular",
        "durationMin": 60,
        "priceCents": 9000,
        "modality": "IN_PERSON",
        "recurrence": "semanal"
      },
      {
        "name": "Aula online",
        "durationMin": 60,
        "priceCents": 8000,
        "modality": "ONLINE"
      },
      {
        "name": "Acompanhamento escolar",
        "durationMin": 60,
        "priceCents": 8000,
        "modality": "IN_PERSON"
      },
      {
        "name": "Preparatório ENEM e vestibular",
        "durationMin": 90,
        "priceCents": 14000,
        "modality": "IN_PERSON"
      },
      {
        "name": "Aula de idiomas",
        "durationMin": 60,
        "priceCents": 9000,
        "modality": "ONLINE"
      }
    ],
    "recordTemplate": {
      "name": "Aula",
      "sections": [
        {
          "title": "Conteúdo",
          "fields": [
            {
              "key": "topic",
              "label": "Conteúdo trabalhado",
              "type": "textarea",
              "required": true
            },
            {
              "key": "homework",
              "label": "Tarefa para casa",
              "type": "textarea"
            },
            {
              "key": "difficulty",
              "label": "Dificuldades observadas",
              "type": "textarea"
            }
          ]
        }
      ]
    },
    "documents": [
      {
        "key": "material",
        "name": "Material de estudo",
        "direction": "OUT"
      },
      {
        "key": "boletim",
        "name": "Boletim / provas",
        "direction": "IN"
      }
    ],
    "compliance": {
      "validation": "PENDENTE_VALIDACAO",
      "confidentiality": "NORMAL",
      "retentionYears": 1,
      "signatureRequired": false,
      "consents": [
        "Tratamento de dados pessoais (LGPD)",
        "Consentimento do responsável para menores"
      ],
      "recordHiddenFrom": [],
      "notes": "Consentimento de responsável para menores a validar por especialista."
    },
    "cancellationPolicy": {
      "minHoursBefore": 12
    },
    "rules": [
      {
        "key": "faltas-aviso",
        "name": "Avisar após 2 faltas seguidas",
        "trigger": "NO_SHOW",
        "conditions": {
          "consecutiveGte": 2
        },
        "actions": [
          {
            "type": "NOTIFY_CLIENT",
            "message": "Notamos que você faltou a {{count}} aulas seguidas. Quer reagendar?"
          }
        ],
        "mode": "AUTO"
      }
    ],
    "careTypes": [
      {
        "key": "reforco",
        "name": "Reforço escolar",
        "description": "Ajuda com matérias da escola, recuperação e organização dos estudos.",
        "services": [
          "Acompanhamento escolar",
          "Aula particular",
          "Aula online"
        ],
        "triage": {
          "questions": [
            {
              "key": "serie",
              "label": "Etapa escolar",
              "type": "select",
              "options": [
                "Educação infantil",
                "Fundamental I (1º ao 5º ano)",
                "Fundamental II (6º ao 9º ano)",
                "Ensino médio"
              ],
              "required": true
            },
            {
              "key": "materias",
              "label": "Matérias",
              "type": "multiselect",
              "options": [
                "Matemática",
                "Português",
                "Ciências",
                "Física",
                "Química",
                "Inglês",
                "História ou Geografia"
              ],
              "required": true
            },
            {
              "key": "motivo",
              "label": "Principal motivo",
              "type": "select",
              "options": [
                "Notas baixas",
                "Recuperação ou prova próxima",
                "Dificuldade de aprendizagem",
                "Organização dos estudos"
              ],
              "required": true
            },
            {
              "key": "prova",
              "label": "Tem prova nos próximos 15 dias?",
              "type": "select",
              "options": [
                "Não",
                "Sim"
              ],
              "required": false
            },
            {
              "key": "diagnostico",
              "label": "Tem algum diagnóstico (TDAH, dislexia, TEA)?",
              "type": "select",
              "options": [
                "Não",
                "Sim",
                "Em investigação"
              ],
              "required": false
            },
            {
              "key": "modalidade",
              "label": "Como prefere ser atendido(a)?",
              "type": "select",
              "options": [
                "Presencial",
                "Online",
                "Tanto faz"
              ],
              "required": true
            }
          ],
          "rules": [
            {
              "if": {
                "field": "serie",
                "in": [
                  "Educação infantil",
                  "Fundamental I (1º ao 5º ano)",
                  "Fundamental II (6º ao 9º ano)",
                  "Ensino médio"
                ]
              },
              "then": {
                "tags": [
                  "menor-de-idade"
                ]
              }
            },
            {
              "if": {
                "field": "prova",
                "equals": "Sim"
              },
              "then": {
                "priority": "ALTA",
                "recommend": "Prova próxima: aulas focadas no conteúdo da prova."
              }
            },
            {
              "if": {
                "field": "motivo",
                "equals": "Recuperação ou prova próxima"
              },
              "then": {
                "priority": "ALTA"
              }
            },
            {
              "if": {
                "field": "diagnostico",
                "in": [
                  "Sim",
                  "Em investigação"
                ]
              },
              "then": {
                "tags": [
                  "atendimento-especializado"
                ],
                "recommend": "Adaptar a metodologia; trazer orientações da escola ou do especialista."
              }
            },
            {
              "if": {
                "field": "modalidade",
                "equals": "Online"
              },
              "then": {
                "service": "Aula online",
                "modality": "ONLINE"
              }
            }
          ]
        }
      },
      {
        "key": "vestibular",
        "name": "ENEM, vestibular e concursos",
        "description": "Plano de estudos e aulas para provas e concursos.",
        "services": [
          "Preparatório ENEM e vestibular",
          "Aula online"
        ],
        "triage": {
          "questions": [
            {
              "key": "prova",
              "label": "Qual prova?",
              "type": "select",
              "options": [
                "ENEM",
                "Vestibular específico",
                "Concurso público",
                "Outra"
              ],
              "required": true
            },
            {
              "key": "data_prova",
              "label": "Data da prova (se souber)",
              "type": "date",
              "required": false
            },
            {
              "key": "disciplinas",
              "label": "Disciplinas com mais dificuldade",
              "type": "multiselect",
              "options": [
                "Matemática",
                "Redação",
                "Linguagens",
                "Ciências da Natureza",
                "Ciências Humanas",
                "Conhecimentos específicos"
              ],
              "required": false
            },
            {
              "key": "horas",
              "label": "Horas de estudo por semana",
              "type": "select",
              "options": [
                "Até 5",
                "6 a 15",
                "Mais de 15"
              ],
              "required": false
            },
            {
              "key": "modalidade",
              "label": "Como prefere ser atendido(a)?",
              "type": "select",
              "options": [
                "Presencial",
                "Online",
                "Tanto faz"
              ],
              "required": true
            }
          ],
          "rules": [
            {
              "if": {
                "field": "modalidade",
                "equals": "Online"
              },
              "then": {
                "service": "Aula online",
                "modality": "ONLINE"
              }
            },
            {
              "if": {
                "field": "disciplinas",
                "equals": "Redação"
              },
              "then": {
                "recommend": "Incluir correção semanal de redação."
              }
            }
          ]
        }
      },
      {
        "key": "idiomas",
        "name": "Idiomas",
        "description": "Inglês, espanhol e outros idiomas para viagem, trabalho ou certificação.",
        "services": [
          "Aula de idiomas"
        ],
        "triage": {
          "questions": [
            {
              "key": "idioma",
              "label": "Idioma",
              "type": "select",
              "options": [
                "Inglês",
                "Espanhol",
                "Francês",
                "Alemão",
                "Italiano",
                "Português para estrangeiros"
              ],
              "required": true
            },
            {
              "key": "nivel",
              "label": "Seu nível",
              "type": "select",
              "options": [
                "Nunca estudei",
                "Básico",
                "Intermediário",
                "Avançado"
              ],
              "required": true
            },
            {
              "key": "objetivo",
              "label": "Objetivo",
              "type": "select",
              "options": [
                "Viagem",
                "Trabalho",
                "Prova de proficiência",
                "Intercâmbio",
                "Conversação"
              ],
              "required": true
            },
            {
              "key": "data_prova",
              "label": "Data da prova",
              "type": "date",
              "required": false,
              "showIf": {
                "field": "objetivo",
                "equals": "Prova de proficiência"
              }
            },
            {
              "key": "modalidade",
              "label": "Como prefere ser atendido(a)?",
              "type": "select",
              "options": [
                "Presencial",
                "Online",
                "Tanto faz"
              ],
              "required": true
            }
          ],
          "rules": [
            {
              "if": {
                "field": "objetivo",
                "equals": "Prova de proficiência"
              },
              "then": {
                "priority": "ALTA",
                "recommend": "Preparação focada no formato da prova."
              }
            },
            {
              "if": {
                "field": "modalidade",
                "equals": "Presencial"
              },
              "then": {
                "modality": "IN_PERSON"
              }
            },
            {
              "if": {
                "field": "nivel",
                "in": [
                  "Básico",
                  "Intermediário",
                  "Avançado"
                ]
              },
              "then": {
                "recommend": "Primeira aula com teste de nivelamento."
              }
            }
          ]
        }
      }
    ]
  }
}
